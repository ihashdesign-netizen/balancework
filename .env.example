# ===== Django =====
SECRET_KEY=changez-moi-en-une-longue-chaine-aleatoire
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,votre-domaine.tn
SITE_URL=https://votre-domaine.tn/
# En production (DEBUG=0), domaines autorisés pour CSRF (ex: https://votre-domaine.tn)
CSRF_TRUSTED_ORIGINS=https://votre-domaine.tn

# ===== Base de données =====
# mysql (production) ou sqlite (tests locaux sans MySQL)
DB_ENGINE=mysql
DB_NAME=balancework
DB_USER=root
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

